{
    "private": false,
    "name": "lionweb-delta-language",
    "version": "2.1.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "clean": "rm -rf node_modules/",
        "build": "npm run generate && tsc",
        "build-app": "vite build",
        "dev": "vite",
        "generate-delta-types": "node dist/custom/FreonCommandLineRunner.js folder -f ../../modelstore/delta -o protocolgen",
        "install-delta-types": "copyfiles ./protocolgen/types/* ../../../lionweb-server/packages/delta-shared/src/types -f",
        "install-delta-definitions": "copyfiles ./protocolgen/definitions/* ../../../lionweb-server/packages/delta-shared/src/types -f",
        "preview": "vite preview",
        "start": "sirv public --port 8000",
        "validate": "svelte-check --tsconfig ./tsconfig.json",
        "errors-only": "svelte-check --threshold error --tsconfig ./tsconfig.json",
        "generate": "freon all -d src/defs -o src/freon",
        "styles": "cross-env NODE_ENV=production npx @tailwindcss/cli -i styles/webapp-styles.css -o ./public/site.css",
        "server": "node ./node_modules/@freon4dsl/server/dist/server/server-starter.js"
    },
    "devDependencies": {
        "@freon4dsl/meta": "~2.1.0",
        "@sveltejs/vite-plugin-svelte": "^5.1.0",
        "@tailwindcss/cli": "^4.1.10",
        "@tailwindcss/vite": "^4.1.10",
        "@tsconfig/svelte": "^5.0.4",
        "cross-env": "7.0.3",
        "native-copyfiles": "^1.3.7",
        "svelte-check": "^4.1.5",
        "svelte-preprocess": "^6.0.3",
        "tailwindcss": "^4.1.4",
        "typescript": "^5.8.2",
        "vite": "^6.3.5"
    },
    "dependencies": {
        "@freon4dsl/core": "~2.1.0",
        "@freon4dsl/core-svelte": "~2.1.0",
        "@freon4dsl/server": "~2.1.0",
        "@freon4dsl/weblib-flowbite": "~2.1.0",
        "@types/node": "^20.14.1",
        "kotlin": "^1.5.21",
        "lodash": "^4.17.21",
        "mobx": "^6.12.3",
        "mobx-utils": "^6.0.8",
        "sirv-cli": "^2.0.2",
        "tslib": "^2.6.2"
    }
}
