{
    "private": false,
    "name": "lionweb-delta-language",
    "version": "1.0.0",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "clean": "rm -rf node_modules/ dist/ package-lock.json",
        "initialize": "npm run clean && npm install && npm run build",
        "build": "npm run generate && tsc",
        "build-app": "vite build",
        "dev": "vite",
        "generate-delta-ts": "node dist/custom/FreonCommandLineRunner.js folder -f ../../modelstore/delta -o delta-gen",
        "install-deltas": "npm run install-delta-types && npm run install-delta-definitions",
        "install-delta-types": "copyfiles ./delta-gen/types/* ../../../lionweb-server/packages/delta-shared/src/types -f",
        "install-delta-definitions": "copyfiles ./delta-gen/definitions/* ../../../lionweb-typescript/packages/validation/src/validators/definitions -f",
        "preview": "vite preview",
        "start": "sirv public --port 8000",
        "validate": "svelte-check --tsconfig ./tsconfig.json",
        "errors-only": "svelte-check --threshold error --tsconfig ./tsconfig.json",
        "generate": "freon all -d src/defs -o src/freon",
        "styles": "cross-env NODE_ENV=production npx @tailwindcss/cli -i styles/webapp-styles.css -o ./public/site.css",
        "server": "echo Start the model server from the root of this repository (above the apps folder)"
    },
    "devDependencies": {
        "@freon4dsl/meta": "3.0.0-beta.1",
        "@sveltejs/vite-plugin-svelte": "^5.1.0",
        "@tailwindcss/cli": "^4.1.10",
        "@tailwindcss/vite": "^4.1.10",
        "@tsconfig/svelte": "^5.0.4",
        "cross-env": "7.0.3",
        "native-copyfiles": "^1.3.7",
        "svelte-check": "^4.1.5",
        "svelte-preprocess": "^6.0.3",
        "tailwindcss": "^4.1.4",
        "typescript": "^5.8.2",
        "vite": "^6.3.5"
    },
    "dependencies": {
        "protobufjs": "8.0.3",
        "@freon4dsl/core": "3.0.0-beta.1",
        "@freon4dsl/core-svelte": "3.0.0-beta.1",
        "@freon4dsl/server": "3.0.0-beta.1",
        "@freon4dsl/weblib-flowbite": "3.0.0-beta.1",
        "@types/node": "^24.13.3",
        "kotlin": "^1.5.21",
        "lodash": "^4.17.21",
        "mobx": "^6.12.3",
        "mobx-utils": "^6.0.8",
        "sirv-cli": "^2.0.2",
        "tslib": "^2.6.2"
    }
}
