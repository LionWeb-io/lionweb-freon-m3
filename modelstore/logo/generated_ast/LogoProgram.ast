language LogoProgram

 modelunit Program implements INamed  {
    commands: ICommand[];
}

 modelunit Library implements INamed  {
    procedures: Procedure;
}

interface ICommand  base INamed {
}

 concept MoveCommand implements ICommand  {
    direction: Direction;
    distance: number;
}

 concept List {
    commands: ICommand[];
}

concept SetPos implements ICommand  {
    x: number;
    y: number;
}

concept SetHeading implements ICommand  {
    degrees: number;
}

 concept HomeCommand implements ICommand  {
}

 concept Repeat {
    count: number;
    list: List;
}

concept If {
    condition: IExpression;
    ifTrue: List;
    ifFalse?: List;
}

interface IExpression {
}

concept Procedure implements INamed  {
    body: List;
    paremeter: Parameter;
}

concept Parameter implements INamed  {
}

limited Direction {
    FORWARD;
    BACK;
    LEFT;
    RIGHT;
}

